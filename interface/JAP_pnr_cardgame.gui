				name = "Background"
				spriteType = "GFX_JAP_pnr_cardgame_table_bg_1"
			}

			instantTextBoxType = {
				name = "jap_pnr_cardgame_russian_alarm_label"
				position = { x = 5 y = @TOP_LABEL_Y }
				font = "hoi_18mbs"
				text = "JAP_pnr_cardgame_russian_alarm_label"
