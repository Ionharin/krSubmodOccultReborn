			font = "hoi_18mbs"
			text = "JAP_pnr_cardgame_current_crisis_heading"
			orientation = center_up
			format = center
			maxWidth = 100
		}

		containerWindowType = {
			name = "jap_pnr_cardgame_crisis_container"
			position = { x = -9 y = -85 }
			size = { width = 150 height = 120 }
			origo = center
			orientation = center
			clipping = no

			background = {
				name = "Background"
				spriteType = "GFX_JAP_pnr_cardgame_holder_bg_1"
