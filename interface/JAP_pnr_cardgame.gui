@TOP_LABEL_Y = 10
@TOP_VALUE_Y = 28
@BOTTOM_LABEL_Y = -30
@BOTTOM_VALUE_Y = -64

guiTypes = {
	containerWindowType = {
		name = "jap_pnr_cardgame_decision_ui"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 330 }

		iconType = {
			name = "jap_pnr_cardgame_hand_icon"
			position = { x = -250 y = 122 }
			spriteType = "GFX_card_hand"
			orientation = center
			pdx_tooltip = "JAP_pnr_cardgame_hand_tt"
		}

		iconType = {
			name = "jap_pnr_cardgame_deck_icon"
			position = { x = 200 y = 122 }
			spriteType = "GFX_card_deck"
